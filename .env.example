# x402-endpoint environment — copy values into the Render dashboard env vars.
# NO secrets in this file: placeholders only.

# --- service ---
# PORT=3000
# BASE_URL=https://your-service.onrender.com   # advertised resource origin
# RPC_URLS=https://base.drpc.org,https://mainnet.base.org
# PRICE_ATOMIC=10000        # /verify price in atomic USDC (10000 = $0.01)
# SCAN_PRICE_ATOMIC=100000  # /scan price in atomic USDC (100000 = $1.00)
# PAY_TO=0x696344061b0f4CcFbA0b48a8390330C6b2525531  # receive-only wallet

# --- hosted facilitator (set these to make the rail EARN; unset = verify-only) ---
# Coinbase CDP hosted facilitator — verifies AND settles payments on-chain.
# As of 2026-11 CDP covers Base mainnet; the x402.org default does not.
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP API key from the CDP console: the key id (kid) and the secret
# (base64 of 64 bytes, seed || public key). Both or neither; both require
# FACILITATOR_URL. Used to mint the per-request EdDSA bearer JWT.
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY=your-base64-cdp-api-key-secret
